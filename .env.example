# OpenAI Codex through a ChatGPT Plus/Pro subscription (default).
HABIBI_MODEL_PROVIDER=openai-codex
HABIBI_MODEL=gpt-5.6-luna

# To use a local Ollama model instead, switch these values and restart Habibi.
# HABIBI_MODEL_PROVIDER=ollama
# HABIBI_MODEL=qwen3:8b
# HABIBI_OLLAMA_URL=http://127.0.0.1:11434

# Optional reasoning level: off, minimal, low, medium, high, xhigh, or max.
HABIBI_THINKING=medium

# Optional overrides.
# HABIBI_AUTH_FILE=/home/you/.config/habibi/auth.json
# HABIBI_OPENAI_CODEX_URL=https://chatgpt.com/backend-api/codex/responses

# Model pricing catalog and refresh source.
# HABIBI_MODEL_CATALOG=model-catalog.json
# HABIBI_MODEL_CATALOG_URL=https://models.dev/api.json

HABIBI_DB=habibi.db
HABIBI_BIND=127.0.0.1:8787
HABIBI_EXTENSIONS_DIR=extensions
HABIBI_EXTENSION_DRAFTS_DIR=extension-drafts

# Optional official Web Search extension (brave or searxng)
HABIBI_SEARCH_PROVIDER=brave
HABIBI_BRAVE_SEARCH_API_KEY=
# HABIBI_SEARXNG_URL=http://127.0.0.1:8080
